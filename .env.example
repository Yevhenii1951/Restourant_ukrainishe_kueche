# Server-only; never expose values to client
NODE_ENV=development
APP_ENV=development
# Required for Supabase email links in deployed environments
URL=
# Local development database, e.g. postgresql://<user>@localhost:5432/kalyna_dev
DATABASE_URL=
TEST_DATABASE_URL=
BOOTSTRAP_ADMIN_AUTH_USER_ID=
BOOTSTRAP_ADMIN_DISPLAY_NAME=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
BREVO_API_KEY=
QUOTE_SIGNING_SECRET=
AI_PROVIDER_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
AI_MONTHLY_BUDGET_EUR=
CRON_SECRET=

# Supabase is optional for public local runtime, required for /admin/login.
# Add /auth/callback to Supabase Auth redirect URLs for invite, magic and reset links.

# Publicly exposed (client-safe)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEMO=true
