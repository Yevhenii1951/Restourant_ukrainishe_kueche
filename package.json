{
  "name": "kalyna",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration --no-file-parallelism",
    "test": "npm run test:unit && npm run test:integration",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:e2e": "playwright test",
    "db:reset": "node --experimental-strip-types scripts/db-reset.mts",
    "db:migrate": "node --experimental-strip-types scripts/db-migrate.mts",
    "db:seed": "node --experimental-strip-types scripts/db-seed.mts",
    "db:bootstrap-admin": "node --experimental-strip-types scripts/bootstrap-admin.mts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "leaflet": "^1.9.4",
    "next": "^16.3.5",
    "next-intl": "^4.14.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "server-only": "^0.0.1",
    "tailwindcss": "4.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.0.0",
    "eslint-config-next": "^16.3.5",
    "pg": "^8.23.0",
    "typescript": "5.8.2",
    "vitest": "3.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
